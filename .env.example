# ─────────────────────── قاعدة البيانات ───────────────────────
# تُولّد قيمة عشوائية: openssl rand -base64 24
POSTGRES_USER=vantara
POSTGRES_PASSWORD=change-me
POSTGRES_DB=vantara

# Uchiyomi قاعدة خارجية — لا تتشارك مع جداول VANTARA
UCHIYOMI_DB=uchiyomi

# ──────────────────── VANTARA API (Node.js) ──────────────
# المنفذ والاتصال
PORT=3100
DATABASE_URL=postgres://vantara:change-me@postgres:5432/vantara
UCHIYOMI_URL=http://uchiyomi:3000
# توكن خدمة Uchiyomi (‏uy_…) — خطوات توليده في docs/DEPLOY.md § 2
# يحتاجه مسار الصور الموقَّع: الرابط يُفتح بلا اعتماد، فالجلب من المنبع بتوكن
# الخدمة. بلا هذا يرجع المسار 503 وتفشل صور القارئ على الـAPK.
UCHIYOMI_SERVICE_TOKEN=

# الأمان
# 32 بايتًا على الأقل: openssl rand -base64 48
SESSION_SECRET=change-me-change-me-change-me-change-me
# يجب أن تكون نفس القيمة Secret في Sync Worker وContent API.
VANTARA_IDENTITY_SECRET=change-me-change-me-change-me-change-me
# Worker فقط: HMAC لـdevice/pairing credentials المخزنة في D1.
VANTARA_DEVICE_PEPPER=change-me-change-me-change-me-change-me
SESSION_TTL_DAYS=60
COOKIE_SECURE=true

# الملفات والسجلات
UPLOAD_DIR=/data/uploads
LOG_LEVEL=info

# الأصل العام للـAPI (للـCookie domain والـCORS)
PUBLIC_ORIGIN=https://vantara.example.com

# أصول إضافية مسموحة، مفصولة بفاصلة. أصول الـAPK (https://localhost و
# capacitor://localhost) مدمجة في القائمة البيضاء فلا تُضاف هنا.
ALLOWED_ORIGINS=https://vantara.pages.dev

# ──────────────────── Suwayomi (محرك الإضافات) ──────────
# افتراضي: 25. الإضافات العربية: 38. اضبط حسب مصادرك
SUWAYOMI_MAX_SOURCES=60
SUWAYOMI_PAGE_CONCURRENCY=4

# ─────────────────────── FlareSolverr ─────────────────
FLARESOLVERR_LOG_LEVEL=warning

# ──────────────────── Cloudflare Tunnel ──────────────
# تُعاد مرة واحدة فقط من: cloudflared tunnel create vantara
# الخطوات في docs/DEPLOY.md § 5
TUNNEL_TOKEN=change-me

# ────────────────────── المسار المحلي ─────────────────
# مكتبتك المحلية (اختياري، الافتراضي ./library)
LIBRARY_PATH=./library

# ────────────────────── النسخ الاحتياطي ────────────────
# Restic للنسخ الاحتياطية المشفرة
RESTIC_REPOSITORY=/backups/restic
RESTIC_PASSWORD=change-me

# ────────────────── المراقبة (اختيارية) ────────────────
# Uptime Kuma + Ntfy لتنبيهات الخدمات
KUMA_PORT=3001
NTFY_PORT=8090
NTFY_BASE_URL=http://localhost:8090
